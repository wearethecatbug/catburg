{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "node-plop>handlebars": "4.7.10",
      "minimatch@3.1.2>brace-expansion": "1.1.21",
      "minimatch@9.0.5>brace-expansion": "2.1.7",
      "minimatch@10.2.5>brace-expansion": "5.0.12",
      "socks>ip-address": "10.7.4",
      "get-uri>basic-ftp": "6.2.6",
      "postcss>source-map-js": "1.2.2"
    },
    "patchedDependencies": {
      "basic-ftp@6.2.6": "patches/basic-ftp@6.2.6.patch"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "react-draggable": "^4.4.6"
  }
}
